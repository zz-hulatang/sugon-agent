OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
# 将浏览器安装在当前虚拟环境中，与下方 README 安装命令配套。
PLAYWRIGHT_BROWSERS_PATH=0
# 留空时优先使用已安装的 Playwright Chromium，否则使用系统 Chrome。
# 可显式设置 chrome 或 msedge。
OA_BROWSER_CHANNEL=

# 可选：同时配置后，点击“打开 OA 登录”即自动填写并提交。密码含 # 时请加引号。
# 不要把真实账号密码发送到聊天中，也不要提交 .env 到版本库。
OA_USERNAME=
OA_PASSWORD=
OA_LOGIN_URL=https://soa.com.cn/sioLogin/
OA_USERNAME_SELECTOR=#username
OA_PASSWORD_SELECTOR=#password
OA_SUBMIT_SELECTOR=#login-slider
OA_VERIFICATION_SELECTOR='#sms-panel:visible, input[autocomplete="one-time-code"]:visible'
OA_LOGIN_ERROR_SELECTOR=#login-error:visible

# 登录后才出现的稳定 CSS 选择器，需现场核实。
OA_SUCCESS_SELECTOR=
# 登录后 URL 正则。两项都配置时必须同时通过；都不配置时检测 OA 用户接口。
OA_SUCCESS_URL_REGEX=
# 默认监听页面自身发出的登录用户请求，成功返回身份且 Token 匹配后自动采集。
OA_USER_INFO_URL=https://msp.soa.com.cn/api/sap/getLoginUser
# 核实后的 SSO/API 主机名，逗号分隔，不填 URL 或通配符。
OA_EXTRA_HOSTS=
OA_TOKEN_KEYS=DP_Token,token,access_token,auth_token,id_token,authorization,x-auth-token,x-access-token
OA_IDLE_SECONDS=1800
OA_RELOGIN_TIMEOUT=180

# MySQL 认证会话仓库；账号需有库内 CREATE/SELECT/INSERT/UPDATE/DELETE 权限。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=oa_agent
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_SSL_CA=
# Fernet 加密密钥，运行 scripts/configure_mysql.py 可生成到本机 .env，不要随意更换。
SESSION_ENCRYPTION_KEY=
